# ============================================================
# CyberLab Backend - Environment Configuration
# Copy this file to .env and populate with real secrets.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT ---
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_A_STRONG_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
